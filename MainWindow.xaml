<Window x:Class="StorageTerm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StorageTerm"
        Width="1180" Height="740"
        MinWidth="900" MinHeight="500"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/StorageTerm.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ===== Barra superior compacta ===== -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A0D10" Offset="0" />
                    <GradientStop Color="#050607" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8"
                            BorderBrush="#2A3B38" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B1B1A" Offset="0" />
                                <GradientStop Color="#070C0E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconTerminal}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock Text="StorageTerm" FontFamily="{StaticResource DisplayFont}"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="9,0,0,0" />
                </StackPanel>

                <Button x:Name="ModeButton" Grid.Column="1" Margin="16,0,0,0"
                        Style="{StaticResource PillButton}" Padding="9,4"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        Click="ModeButton_Click"
                        ToolTip="Modo de conexão global — clique para trocar">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ModeDot" Width="5" Height="5" Fill="{StaticResource GreenBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="ModeButtonText" Text="AUTO · LAN" FontSize="10"
                                   VerticalAlignment="Center" />
                        <Path Data="{StaticResource IconChevronDown}" Width="8" Height="8" Stretch="Uniform"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Margin="6,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border x:Name="ToastBadge" Grid.Column="2" Opacity="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#0B1115" BorderBrush="#22322F" BorderThickness="1"
                        CornerRadius="13" Padding="10,3" MaxWidth="520">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ToastDot" Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="ToastText" Text="" FontSize="10.5"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0B0F12" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="7,2"
                            VerticalAlignment="Center" ToolTip="Máximo de 6 terminais">
                        <TextBlock x:Name="CountText" Text="0 / 6" FontFamily="{StaticResource MonoFont}"
                                   FontSize="9.5" Foreground="{StaticResource TextDimBrush}" />
                    </Border>
                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="9,0" />
                    <Button x:Name="NewButton" Style="{StaticResource AccentButton}"
                            Width="30" Height="30" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            AutomationProperties.Name="Novo terminal"
                            Click="NewButton_Click" ToolTip="Novo terminal (Ctrl+T)">
                        <Path Data="{StaticResource IconPlus}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="#0A1513" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}"
                            Width="26" Height="26" Margin="4,0,0,0"
                            AutomationProperties.Name="Mais ações"
                            Click="MoreButton_Click" ToolTip="Mais ações">
                        <Path Data="{StaticResource IconMore}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Área dos terminais ===== -->
        <Grid x:Name="PaneHost" Grid.Row="1" Background="{StaticResource BgBrush}" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="EmptyState" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="6"
                    Panel.ZIndex="50" Background="{StaticResource BgBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <Border Width="64" Height="64" CornerRadius="18"
                            BorderBrush="#2A3B38" BorderThickness="1" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B1B1A" Offset="0" />
                                <GradientStop Color="#060A0C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconTerminal}" Width="27" Height="27" Stretch="Uniform"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="Conectando ao storage…"
                               FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock x:Name="EmptySubtitle" Text="Detectando storage-lan na rede local…"
                               FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button x:Name="EmptyActionButton" Margin="0,18,0,0"
                            Style="{StaticResource AccentButton}" Padding="10,5"
                            HorizontalAlignment="Center" Click="EmptyAction_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="#0A1513" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Abrir um terminal" FontSize="11" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Border Background="#0B0F12" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                            <TextBlock Text="Ctrl+T" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       Foreground="{StaticResource TextDimBrush}" />
                        </Border>
                        <TextBlock Text="abre outro terminal · máximo de 6" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Rodapé discreto ===== -->
        <Border Grid.Row="2" Background="#040506"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="FooterDot" Width="5" Height="5" Fill="{StaticResource TextMutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="FooterLeft" Text="0 terminais · máximo 6" FontSize="9.5"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Ctrl+T novo  ·  Ctrl+Q fechar"
                           FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="16,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0B0F12" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="FooterConnectionDot" Width="4" Height="4"
                                     Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                     Margin="0,0,5,0" />
                            <TextBlock x:Name="FooterConnection" Text="verificando…" FontSize="9.5"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0B0F12" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="FooterAwakeIcon" Data="{StaticResource IconShield}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{StaticResource GreenBrush}" StrokeThickness="1.8"
                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="FooterAwake" Text="PC acordado" FontSize="9.5"
                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

