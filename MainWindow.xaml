<Window x:Class="StorageTerm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StorageTerm"
        Width="1180" Height="740"
        MinWidth="900" MinHeight="500"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/StorageTerm.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ===== Barra superior única: modo global + painel ativo + ações ===== -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#111111" Offset="0" />
                    <GradientStop Color="#0A0A0A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ModeButton" Grid.Column="0"
                        Style="{StaticResource PillButton}" Padding="9,4"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        Click="ModeButton_Click"
                        ToolTip="Modo de conexão global — clique para trocar">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ModeDot" Width="5" Height="5" Fill="{StaticResource GreenBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="ModeButtonText" Text="AUTO · LAN" FontSize="10"
                                   VerticalAlignment="Center" />
                        <Path Data="{StaticResource IconChevronDown}" Width="8" Height="8" Stretch="Uniform"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Margin="6,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border x:Name="ActivePaneSeparator" Grid.Column="1"
                        Width="1" Height="16" Background="{StaticResource BorderBrush}"
                        Margin="10,0" VerticalAlignment="Center" />

                <StackPanel x:Name="ActivePaneGroup" Grid.Column="2"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveIndexText" Text="#1"
                               FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Ellipse x:Name="ActiveStatusDot" Width="5" Height="5"
                             Fill="{StaticResource TextMutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="ActiveHostText" Text="storage"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ActiveBranchText" Text="branch: —"
                               FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="9,0,0,0"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"
                               ToolTip="Branch do agente neste terminal" />
                    <Border x:Name="ActiveModeBadge"
                            Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1"
                            CornerRadius="5" Padding="5,1" Margin="7,0,0,0"
                            VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="Modo deste terminal"
                            MouseLeftButtonDown="ActiveModeBadge_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ActiveModeDot" Width="4" Height="4"
                                     Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"
                                     Margin="0,0,3,0" />
                            <TextBlock x:Name="ActiveModeText" Text="LAN" FontSize="8"
                                       FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ActiveStatusText" Text="conectando…"
                               FontSize="9.5" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <Border x:Name="ToastBadge" Grid.Column="0" Grid.ColumnSpan="9" Opacity="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1"
                        CornerRadius="13" Padding="10,3" MaxWidth="420"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ToastDot" Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="ToastText" Text="" FontSize="10.5"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ActivePaneActions" Grid.Column="4"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ActiveReconnectButton" Style="{StaticResource PaneIconButton}"
                            AutomationProperties.Name="Reconectar terminal ativo"
                            ToolTip="Reconectar este terminal"
                            Click="ActiveReconnect_Click">
                        <Path Data="{StaticResource IconRefresh}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                    <Button x:Name="ActivePaneMenuButton" Style="{StaticResource PaneIconButton}"
                            Margin="2,0,0,0"
                            AutomationProperties.Name="Opções do terminal ativo"
                            ToolTip="Opções deste terminal"
                            Click="ActivePaneMenu_Click">
                        <Path Data="{StaticResource IconMore}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button x:Name="ActiveCloseButton" Style="{StaticResource PaneIconButton}"
                            Margin="2,0,0,0"
                            AutomationProperties.Name="Fechar terminal ativo"
                            ToolTip="Fechar terminal (Ctrl+Q)"
                            Click="ActiveClose_Click">
                        <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>

                <Border x:Name="ActivePaneActionsSeparator" Grid.Column="5"
                        Width="1" Height="14" Background="{StaticResource BorderBrush}"
                        Margin="9,0" VerticalAlignment="Center" />

                <Border Grid.Column="6" Background="#111111" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="7,2"
                        VerticalAlignment="Center" ToolTip="Terminais abertos (sem limite)">
                    <TextBlock x:Name="CountText" Text="0" FontFamily="{StaticResource MonoFont}"
                               FontSize="9.5" Foreground="{StaticResource TextDimBrush}" />
                </Border>

                <Button x:Name="NewButton" Grid.Column="7" Style="{StaticResource AccentButton}"
                        Width="28" Height="28" Padding="0" Margin="9,0,0,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        AutomationProperties.Name="Novo terminal"
                        Click="NewButton_Click" ToolTip="Novo terminal (Ctrl+T)">
                    <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="#0A0A0A" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>

                <Button x:Name="MoreButton" Grid.Column="8" Style="{StaticResource IconButton}"
                        Width="24" Height="24" Margin="4,0,0,0"
                        AutomationProperties.Name="Mais ações"
                        Click="MoreButton_Click" ToolTip="Mais ações">
                    <Path Data="{StaticResource IconMore}" Width="13" Height="13" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>
        </Border>

        <!-- ===== Carrossel horizontal: 2 terminais visíveis, novos à direita ===== -->
        <Grid Grid.Row="1" Background="{StaticResource BgBrush}">
            <ScrollViewer x:Name="PaneScroller"
                          Margin="4,4,4,0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly"
                          PreviewMouseWheel="PaneScroller_PreviewMouseWheel"
                          Background="{StaticResource BgBrush}">
                <StackPanel x:Name="PaneHost" Orientation="Horizontal"
                            Background="{StaticResource BgBrush}" />
            </ScrollViewer>

            <Border x:Name="EmptyState" Panel.ZIndex="50" Background="{StaticResource BgBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <TextBlock x:Name="EmptyTitle" Text="Conectando ao storage…"
                               FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptySubtitle" Text="Detectando storage-lan na rede local…"
                               FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button x:Name="EmptyActionButton" Margin="0,18,0,0"
                            Style="{StaticResource AccentButton}" Padding="10,5"
                            HorizontalAlignment="Center" Click="EmptyAction_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="#0A0A0A" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Abrir um terminal" FontSize="11" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Border Background="#111111" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                            <TextBlock Text="Ctrl+T" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       Foreground="{StaticResource TextDimBrush}" />
                        </Border>
                        <TextBlock Text="abre outro terminal · sem limite" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Rodapé discreto ===== -->
        <Border Grid.Row="2" Background="#0A0A0A"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="FooterDot" Width="5" Height="5" Fill="{StaticResource TextMutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="FooterLeft" Text="0 terminais · máximo 6" FontSize="9.5"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Ctrl+T novo  ·  Ctrl+Q fechar"
                           FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="16,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#111111" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="FooterConnectionDot" Width="4" Height="4"
                                     Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                     Margin="0,0,5,0" />
                            <TextBlock x:Name="FooterConnection" Text="verificando…" FontSize="9.5"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#111111" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="FooterAwakeIcon" Data="{StaticResource IconShield}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{StaticResource GreenBrush}" StrokeThickness="1.8"
                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="FooterAwake" Text="PC acordado" FontSize="9.5"
                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>



