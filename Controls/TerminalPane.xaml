<UserControl x:Class="StorageTerm.Controls.TerminalPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="http://schemas.lepo.co/wpfui/2022/xaml/terminal"
             Background="Transparent"
             Focusable="False"
             SnapsToDevicePixels="True">

    <Border x:Name="PaneBorder"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1"
            PreviewMouseLeftButtonDown="PaneBorder_PreviewMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Faixa de cor do terminal (identifica o agente) -->
            <Border x:Name="ColorBar"
                    Grid.Row="0"
                    Background="#3A3A3A"
                    SnapsToDevicePixels="True" />

            <!-- Cabeçalho antigo (oculto: a barra única da janela mostra o painel ativo) -->
            <Border x:Name="Header"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#111111"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    MouseRightButtonDown="Header_MouseRightButtonDown">
                <Grid Margin="0,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ActiveBar"
                            Grid.Column="0"
                            Width="3" Height="12" CornerRadius="1.5"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />

                    <TextBlock x:Name="IndexText"
                               Grid.Column="1"
                               Text="#1"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="5" Height="5"
                                 Fill="{StaticResource AmberBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock x:Name="HostText"
                                   Text="storage"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="ModeBadge"
                                Background="#1A1A1A"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="5,1"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonDown="ModeBadge_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ModeDot" Width="4" Height="4"
                                         Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"
                                         Margin="0,0,3,0" />
                                <TextBlock x:Name="ModeText"
                                           Text="LAN"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource GreenBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="4"
                               Text="conectando…"
                               FontSize="9.5"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,6,0" />

                    <Button x:Name="ReconnectButton"
                            Grid.Column="5"
                            Style="{StaticResource PaneIconButton}"
                            AutomationProperties.Name="Reconectar"
                            ToolTip="Reconectar esta sessão"
                            Click="Reconnect_Click">
                        <Path Data="{StaticResource IconRefresh}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>

                    <Button x:Name="PaneMenuButton"
                            Grid.Column="6"
                            Style="{StaticResource PaneIconButton}"
                            AutomationProperties.Name="Opções do terminal"
                            ToolTip="Opções do terminal"
                            Click="PaneMenu_Click">
                        <Path Data="{StaticResource IconMore}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>

                    <Button x:Name="CloseButton"
                            Grid.Column="7"
                            Style="{StaticResource PaneIconButton}"
                            AutomationProperties.Name="Fechar terminal"
                            ToolTip="Fechar terminal (Ctrl+Q / Ctrl+Shift+W)"
                            Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Border>

            <!-- Terminal nativo (Windows Terminal / ConPTY) -->
            <Grid Grid.Row="1" Background="#0A0A0A">
                <t:ExtendedTerminalControl x:Name="Term"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Border>
</UserControl>






