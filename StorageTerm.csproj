<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>StorageTerm</AssemblyName>
    <RootNamespace>StorageTerm</RootNamespace>
    <ApplicationIcon>Assets\StorageTerm.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>StorageTerm</Product>
    <AssemblyTitle>StorageTerm</AssemblyTitle>
    <Description>Gerenciador de terminais SSH com layout inteligente para storage-lan / storage.</Description>
    <Company>StorageTerm</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.0</FileVersion>
    <RepositoryUrl>https://github.com/jhordan-pastorello/gerenciado-terminal-ssh</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jhordan-pastorello/gerenciado-terminal-ssh</PackageProjectUrl>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI.Terminal" Version="1.0.39" />
  </ItemGroup>

  <ItemGroup>
    <!-- Evita ambiguidade entre WPF e WinForms (usamos WinForms só no ícone da bandeja). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\StorageTerm.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Page Remove="tests\**\*.xaml" />
    <None Remove="tests\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
  </ItemGroup>

</Project>
